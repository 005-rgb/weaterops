{
  "name": "weatherops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "npm run build:frontend && tsx src/server.ts",
    "build:frontend": "vite build",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:migrate": "node-pg-migrate -m src/infrastructure/database/migrations up",
    "seed:dev": "tsx scripts/seed-dev.ts",
    "benchmark:geospatial": "tsx scripts/geospatial-benchmark.ts",
    "db:bootstrap": "npm run db:migrate && npm run seed:dev",
    "bmkg:contract": "tsx scripts/bmkg-contract-test.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests eslint.config.js vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "i18next": "^26.4.0",
    "maplibre-gl": "^6.5.0",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-map-gl": "^8.1.2",
    "vite": "^8.2.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.9.0",
    "node-pg-migrate": "^9.0.0",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "node-pg-migrate": {
    "migrations-table": "pgmigrations",
    "dir": "src/infrastructure/database/migrations",
    "database-url-var": "DATABASE_URL"
  }
}
